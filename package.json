{
  "name": "csv-compass",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first CSV explorer with data quality checks and downloadable reports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.8"
  }
}
